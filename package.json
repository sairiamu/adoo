{
  "name": "adoo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n editor,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "npm run typecheck && vite build",
    "studio": "remotion studio",
    "render:still": "remotion still",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"vite.config.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \"index.html\" \".prettierrc.json\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"vite.config.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \"index.html\" \".prettierrc.json\""
  },
  "dependencies": {
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "express": "^5.3.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.3",
    "remotion": "4.0.535",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "^4.0.535",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
